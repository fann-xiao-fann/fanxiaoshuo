# =============================================================================
# 梵小说（FanXiaoshuo）环境变量模板
# =============================================================================
# 使用方式：复制本文件为仓库根目录的 `.env`（`.env` 已被 .gitignore 忽略，永不入库）
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
# 或执行一键初始化（自动复制并生成 APP_ENCRYPTION_KEY）： pnpm env:init
# -----------------------------------------------------------------------------

# ── PostgreSQL（Docker） ─────────────────────────────────────────────────────
# docker-compose.yml 使用的容器参数（默认值与下方 DATABASE_URL 保持一致）
POSTGRES_USER=fanxiaoshuo
POSTGRES_PASSWORD=fanxiaoshuo
POSTGRES_DB=fanxiaoshuo
POSTGRES_PORT=5432

# 应用侧连接串（apps/server / apps/worker / drizzle-kit 统一读取）
DATABASE_URL=postgres://fanxiaoshuo:fanxiaoshuo@localhost:5432/fanxiaoshuo

# ── Redis（Docker，BullMQ 队列 + Pub/Sub 事件总线） ───────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── 安全主密钥（必填，服务启动时缺失将 fail-fast） ───────────────────────────
# 用于 AES-256-GCM 加密 Provider API Key，需为 32 字节随机值的 hex（64 字符）或 base64。
# 一键生成（任选其一，复制输出填入下方）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 注意：更换主密钥会导致已存 API Key 无法解密，请先备份。
APP_ENCRYPTION_KEY=

# ── 服务端口 ────────────────────────────────────────────────────────────────
# Fastify API（apps/server）
API_PORT=3001
# Vite 前端开发服务器（apps/web）
WEB_PORT=5173
# BullMQ Worker 并发度（apps/worker）
WORKER_CONCURRENCY=3

# ── 前端（apps/web，Vite 仅注入 VITE_ 前缀变量） ─────────────────────────────
# 开发期经 Vite dev proxy 转发到 API；生产同源部署时同样使用该相对路径
VITE_API_BASE_URL=/api/v1
