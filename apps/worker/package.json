{
  "name": "@fanxiaoshuo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "梵小说 BullMQ 后台 Worker：runtime-smoke 队列消费、心跳上报、Pub/Sub 事件与 Mastra 冒烟执行",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@fanxiaoshuo/agents": "workspace:*",
    "@fanxiaoshuo/shared": "workspace:*",
    "bullmq": "^6.7.7",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
